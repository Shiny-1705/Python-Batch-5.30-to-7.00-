#Palindrome
a=int(input("Enter a:"))
b=0
t=a
while t>0:
    d=t%10
    b=b*10+d
    t=t//10
print(b)
if b==a:
    print("Palindrome")
else:
    print("Not a Palindrome")

#Spy numbers
a=int(input("Enter a:"))
b=0
c=1
t=a
while t>0:
    d=t%10
    b=b+d
    c=c*d
    t=t//10
print(b)
print(c)
if b==c:
    print("Spy numbers")
else:
    print("Not a Spy numbers")

